+        maps.append((m, r, sm))
+        print(f"    Az {sm['Az_km']:.0f} km: entry {sm['entry']}/{sm['n']}, moon {sm['moon']}, escape {sm['escape']}, "
+              f"lowest perigee {sm['min_perigee_alt_km']:.0f} km")
+    res["earth_approach"] = {"t_max_days": t_max, "n_samples": n_map, "entry_altitude_km": 120.0,
